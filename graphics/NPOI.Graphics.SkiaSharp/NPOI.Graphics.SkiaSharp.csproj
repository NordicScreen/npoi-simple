<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net472;netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
		<RootNamespace>NPOI.Graphics.SkiaSharp</RootNamespace>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\..\npoi.snk</AssemblyOriginatorKeyFile>
		<OutputPath>..\..\solution\$(Configuration)\</OutputPath>
		<Title>NPOI.Graphics.SkiaSharp</Title>
		<Description>SkiaSharp based font and image providers for NPOI.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\main\NPOI.Core.csproj" />
	</ItemGroup>

</Project>
